# =====================================================================
#  Quéops Pirâmides — variáveis de ambiente do servidor
#
#  Copie para `.env` e preencha. NUNCA versione o `.env`: ele guarda a senha
#  do banco e a chave que cifra as credenciais das integrações.
#
#  Na Hostinger você pode preencher estes mesmos nomes em
#  hPanel → Avançado → Node.js → sua aplicação → Environment variables,
#  e aí não precisa subir arquivo nenhum.
# =====================================================================

# ---- Banco de dados (hPanel → Bancos de Dados → MySQL) ----
# O nome do banco e o usuário levam o prefixo da conta — algo como
# u123456789_queops.
#
# Use 127.0.0.1, não "localhost": o driver resolve "localhost" por DNS e chega
# como ::1 (IPv6), host para o qual o usuário do MySQL da Hostinger não tem
# permissão. O sintoma é ER_ACCESS_DENIED_ERROR com a senha certa — e, como o
# servidor encerra quando o banco não responde, a loja fica em 503.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000000_queops
DB_USER=u000000000_queops
DB_PASS=TROQUE_ESTA_SENHA

# ---- Chave de cifra das integrações (32 bytes em base64) ----
# Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# GUARDE ESTA CHAVE junto das senhas do projeto. Trocá-la depois torna
# ilegíveis os tokens de ERP, WhatsApp e gateways já salvos no banco.
APP_KEY=

# ---- Endereço público da loja ----
# Usado nos links das mensagens de recuperação de carrinho.
APP_URL=https://queopspiramides.com.br

# ---- Ambiente ----
# production esconde detalhes de erro do cliente. Use development só localmente.
APP_ENV=production

# Cookies de sessão só trafegam em HTTPS. Deixe true em produção;
# em desenvolvimento (http://localhost) precisa ser false.
SECURE_COOKIES=true

# ---- Rede ----
# A Hostinger define PORT automaticamente; não precisa mexer em produção.
PORT=8080
HOST=0.0.0.0

# Pasta com a vitrine compilada, relativa à raiz da aplicação.
#
# OPCIONAL: o servidor detecta sozinho — "public" no pacote de deploy, "dist"
# quando se roda o projeto inteiro. Só defina para apontar outra pasta.
# PUBLIC_DIR=public

# ---- Opcionais ----
# HSTS: só ligue depois de confirmar que o HTTPS responde em todo o domínio.
# Uma vez enviado, o navegador se recusa a acessar o site por HTTP por um ano.
# HSTS=true

# Conexões simultâneas no pool do MySQL. 10 é folgado para uma loja; abaixe se
# o plano reclamar de "too many connections".
# DB_POOL=10

# Na subida, o servidor acrescenta ao banco as colunas e índices que o código
# espera e o banco ainda não tem. Só isso: nada é apagado, transformado ou
# recarregado — instalar e carregar catálogo continua sendo trabalho do
# migrate.js.
#
# Existe porque esquecer a migração é silencioso e caro: a loja sobe, o catálogo
# aparece, e a falha só aparece no meio de um pagamento. Desligue apenas se o
# usuário do MySQL não puder ter permissão de ALTER TABLE — nesse caso, rode
# `node migrate.js` a cada atualização que mexa no esquema.
# AUTO_MIGRAR=false
