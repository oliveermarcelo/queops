# ---- SPA routing (React) ----
# Faz /admin e qualquer outra rota carregarem o index.html em vez de 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se o arquivo/pasta existir de verdade (assets, imagens), serve normalmente.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Caso contrário, devolve o index.html (o roteador do React resolve a rota).
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Cabeçalhos de segurança ----
# frame-ancestors só vale como header HTTP real (o navegador ignora a diretiva
# quando ela vem na <meta> do index.html), por isso ela fica aqui.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compressão (gzip) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ---- Cache dos assets com hash (Vite gera nomes únicos por build) ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # O HTML nunca deve ser cacheado, para sempre pegar o build novo.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
