# =====================================================================
#  API — todas as requisições /api/* caem no index.php
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # Arquivo existente (nenhum, na prática) é servido normalmente.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # O resto vira index.php?route=<caminho>
  RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Nada além do index.php pode ser buscado diretamente.
#
# Antes só alguns nomes eram negados, e como a regra de rewrite serve arquivos
# existentes, um GET em /api/routes/public.php executava o arquivo fora de
# contexto — erro fatal, com risco de vazar o caminho absoluto do servidor.
# Agora o padrão é negar: nega-se tudo e libera-se apenas o index.php.
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

# O instalador precisa ser alcançável por quem não tem SSH. Ele já se protege
# sozinho (exige `setup_key` e recusa rodar se já existir administrador), e o
# DEPLOY.md manda apagá-lo depois da instalação.
<Files "migrate.php">
  Require all granted
</Files>

# Apache 2.2 (Hostinger antiga) usa a sintaxe anterior.
<IfModule !mod_authz_core.c>
  <FilesMatch ".*">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <Files "index.php">
    Order allow,deny
    Allow from all
  </Files>
  <Files "migrate.php">
    Order allow,deny
    Allow from all
  </Files>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # A API não deve ser embutida em iframe nem cacheada.
  Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
  Header always set Cache-Control "no-store"
</IfModule>

# Listagem de diretório desligada.
Options -Indexes
